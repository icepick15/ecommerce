# Docker Environment Variables for Production
# Copy this to .env in production and fill in your actual values

# MongoDB Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secrets (Generate new ones for production!)
ACCESS_TOKEN_SECRET=your_production_access_token_secret_64_chars_minimum
REFRESH_TOKEN_SECRET=your_production_refresh_token_secret_64_chars_minimum

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paystack (Use LIVE key in production!)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_live_secret_key

# Frontend URL (Your AWS Amplify URL)
CLIENT_URL=https://your-app.amplifyapp.com
